# Goal Tracker - Apache settings (HostGator uses Apache)
Options -Indexes
DirectoryIndex index.php

# Block direct web access to the config file and other private files.
<FilesMatch "^(config\.php|config\.sample\.php|README\.md|\.git.*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
